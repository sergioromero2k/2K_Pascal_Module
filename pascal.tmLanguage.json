{
  "name": "Pascal",
  "scopeName": "source.pascal",
  "fileTypes": ["pas", "pp"],
  "patterns": [
    {
      "name": "comment.block.pascal",
      "begin": "\\{",
      "end": "\\}"
    },
    {
      "name": "comment.line.double-slash.pascal",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.single.pascal",
      "begin": "'",
      "end": "'"
    },
    {
      "name": "keyword.control.pascal",
      "match": "\\b(?i:(program|begin|end|var|const|type|if|then|else|while|do|for|to|downto|repeat|until|case|of))\\b"
    },
    {
      "name": "support.function.pascal",
      "match": "\\b(?i:(writeln|write|readln|read))\\b"
    },
    {
      "name": "storage.type.pascal",
      "match": "\\b(?i:(integer|shortint|smallint|longint|real|boolean|char|string))\\b"
    }
  ]
}